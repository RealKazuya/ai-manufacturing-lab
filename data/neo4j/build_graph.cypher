MATCH (a:Location {name:'中部國際機場'}), (b:Location {name:'桃園機場'}) CREATE (a)-[:ROUTE {mode:'空運', days:1.0, cost:6.3}]->(b);
MATCH (a:Location {name:'桃園機場'}), (b:Location {name:'恆準台中廠'}) CREATE (a)-[:ROUTE {mode:'陸運', days:0.5, cost:0.5}]->(b);

